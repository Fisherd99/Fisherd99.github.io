{
  "name": "vitepress",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/patch-alphatab.mjs",
    "docs:dev": "node scripts/generate-content.mjs && vitepress dev",
    "docs:build": "node scripts/generate-scores.js --verify && node scripts/generate-content.mjs && vitepress build",
    "docs:preview": "vitepress preview",
    "generate-content": "node scripts/generate-content.mjs",
    "generate-nav": "node scripts/generate-nav-config.js",
    "generate-articles": "node scripts/generate-articles-list.js",
    "generate-llms": "node scripts/generate-llms-txt.js",
    "generate-scores": "node scripts/generate-scores.js",
    "cf:pageview:dev": "wrangler dev cloudflare/pageview-worker.js --config cloudflare/wrangler.toml",
    "cf:pageview:deploy": "wrangler deploy --config cloudflare/wrangler.toml",
    "cf:pageview:d1:create": "wrangler d1 create fisherd-pageview-db --config cloudflare/wrangler.toml",
    "cf:pageview:d1:info": "wrangler d1 info DB --config cloudflare/wrangler.toml",
    "cf:pageview:d1:migrate": "wrangler d1 execute DB --remote --config cloudflare/wrangler.toml --file cloudflare/schema.sql",
    "cf:pageview:d1:migrate:local": "wrangler d1 execute DB --local --config cloudflare/wrangler.toml --file cloudflare/schema.sql",
    "test:scores": "node scripts/patch-alphatab.mjs && node --test scripts/score-player.test.mjs scripts/score-soundfonts.test.mjs scripts/score-worklet.test.mjs",
    "test:site": "node --test scripts/content.test.mjs scripts/analytics.test.mjs",
    "test": "npm run test:site && npm run test:scores"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.8.4",
    "@mdit/plugin-katex": "^0.22.0",
    "@vue/compiler-sfc": "3.5.22",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "medium-zoom": "^1.1.0",
    "vitepress": "^2.0.0-alpha.12",
    "wrangler": "4.142.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "@giscus/vue": "^3.1.1"
  }
}
